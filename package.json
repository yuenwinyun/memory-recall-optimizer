{
  "name": "@openclaw/memory-recall-optimizer",
  "version": "0.1.0",
  "description": "OpenClaw hook plugin to improve memory recall reliability and observability.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "OpenClaw Contributors",
  "files": [
    "api.ts",
    "index.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "openclaw": "^2026.4.1",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuenwinyun/memory-recall-optimizer.git"
  },
  "homepage": "https://github.com/yuenwinyun/memory-recall-optimizer#readme",
  "bugs": {
    "url": "https://github.com/yuenwinyun/memory-recall-optimizer/issues"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/memory-recall-optimizer",
      "defaultChoice": "npm"
    },
    "release": {
      "publishToNpm": true
    },
    "compat": {
      "pluginApi": ">=2026.4.1"
    }
  }
}
